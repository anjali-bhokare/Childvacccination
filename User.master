                                    </td>
                                    <td>
                                        <asp:HyperLink ID="HyperLink1" runat="server"  NavigateUrl="~/User/Login.aspx" >Login</asp:HyperLink>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="text-align: left" class="auto-style9">
                <asp:Menu ID="Menu2" runat="server" Height="30px" Orientation="Horizontal" RenderingMode="Table" Width="100%"  BackColor="#006699" ForeColor="White">
                    <Items>
                        <asp:MenuItem Text="Home" Value="Home" NavigateUrl="~/User/Home.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="About Vaccine" Value="About Vaccine" NavigateUrl="~/User/AboutVaccination.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Vaccine Calender" Value="Vaccine Calender" NavigateUrl="~/User/calender.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Book Home Vaccine" Value="Book Home Vaccine" NavigateUrl="~/User/Bookhome.aspx"></asp:MenuItem>
