                                    </td>
                                </tr>
                                <tr>
                                    <td class="auto-style9">
                                        <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/User/AboutVaccination.aspx" ForeColor="White" Width="250px" CssClass="auto-style11">About Vaccination</asp:HyperLink>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="auto-style9">
                                        <asp:HyperLink ID="HyperLink4" runat="server" NavigateUrl="~/User/calender.aspx" ForeColor="White" CssClass="auto-style11">Vaccine  Schedule</asp:HyperLink>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="auto-style12">
                                        <asp:HyperLink ID="HyperLink5" runat="server" NavigateUrl="~/User/SearchVaccine.aspx" ForeColor="White" CssClass="auto-style11">Vaccine Center</asp:HyperLink>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td style="background-color: #3C87C8;">
                            <table class="auto-style1" cellpadding="5" cellspacing="1">
                                <tr>
                                    <td class="auto-style6" style="color: #FFFFFF" >
                                        <div class="auto-style9">
                                            <strong>Quick Links:</div>
                                        <hr />
                                        </strong></td>
                                </tr>
                                <tr>
