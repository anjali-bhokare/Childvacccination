                                        <asp:HyperLink ID="HyperLink6" runat="server" NavigateUrl="~/User/Login.aspx" ForeColor="White" CssClass="auto-style11">Parent Login</asp:HyperLink>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color: #FFFFFF" class="auto-style9">
                                        <asp:HyperLink ID="HyperLink7" runat="server" NavigateUrl="~/Parent/feedback.aspx" ForeColor="White" CssClass="auto-style11">Feedback</asp:HyperLink>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="auto-style12" style="color: #FFFFFF">
                                        <asp:HyperLink ID="HyperLink8" runat="server" NavigateUrl="~/User/Enquiry.aspx" ForeColor="White" CssClass="auto-style11">Enquiry</asp:HyperLink>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color: #FFFFFF" class="auto-style9">
                                        <asp:HyperLink ID="HyperLink9" runat="server" NavigateUrl="~/Parent/BookVaccine.aspx" ForeColor="White" Width="200px" CssClass="auto-style11">Appointment</asp:HyperLink>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td>
