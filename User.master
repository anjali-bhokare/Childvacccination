                        <asp:MenuItem Text="Enquiry" Value="Enquiry" NavigateUrl="~/User/Enquiry.aspx"></asp:MenuItem>
                    </Items>
                </asp:Menu>
            </td>
        </tr>
        <tr>
            <td>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </td>
        </tr>
        <tr>
            <td>
                <table align="center" class="auto-style1" cellpadding="20" style="background-color: #3C87C8; color: #FFFFFF">
                    <tr>
                        <td class="" style="background-color: #3C87C8;">
                            <div class="auto-style9">
                                <strong><span class="auto-style6">Child Vaccination Website:</span></div>
                            <hr />
                            </strong><span class=""><br />
&nbsp;We are committed to safeguarding children&#39;s health through timely and reliable vaccination services.
                          
                            Our mission is to provide accessible, accurate, and up-to-date immunization support to parents and caregivers.
                          
                            Backed by certified healthcare professionals and government guidelines, we ensure every child gets the protection&nbsp;they&nbsp;deserve.</span></td>
                        <td class="" style="background-color: #3C87C8;"> &nbsp;</td>
                        <td  style="background-color: #3C87C8;">
                            <table align="center" cellpadding="5" cellspacing="1" class="auto-style1" style="color: #FFFFFF">
                                <tr>
                                    <td class="auto-style6">
                                        <div class="auto-style9">
                                            <strong>programs:</div>
                                        <hr />
                                        </strong></td>
                                </tr>
                                <tr>
